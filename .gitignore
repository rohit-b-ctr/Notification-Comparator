# ─── Secrets (NEVER commit) ──────────────────────────────────────────────────
.config_key
.secrets
*.pem
*.key
id_rsa*
*_rsa
*.ppk

# ─── Local config ─────────────────────────────────────────────────────────────
# config.json holds host/IP details plus encrypted DB password blobs (see
# .config_key above) — never commit it.
config.json

# ─── Captured data / generated output ────────────────────────────────────────
topic_baseline/*.json
golden/**/*.json
reports/*.html
reports/*.zip
reports/*.meta.json
allure-results/
bkp/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ─── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
